// fallow: unused code, duplication, circular imports and complexity.
//
// The `fallow` job in .github/workflows/ci.yml reads this file:
//   - `pnpm fallow:ci`  whole tree, unresolved imports + unlisted dependencies only.
//   - `pnpm fallow:new-dead-code <ref>`  PRs only, fails on dead code the head
//     has anywhere that the base ref doesn't.
//   - `pnpm fallow:audit --base <ref>`  PRs only, reports new duplication and
//     complexity in the changed files without failing.
// `pnpm fallow` locally shows the whole backlog, and exits 1 while there is one.
//
// Framework plugins discover most entry points (package.json exports/bin, vitest,
// Next, Vite, Docusaurus, Storybook). `entry` lists only what they can't see.
{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "minimumVersion": "3.33.1",

  "entry": [
    "scripts/*.mjs",
    // Committed one-shot codemods, run by path with tsx (scripts/codemod/README.md).
    "scripts/codemod/*.ts",
    ".omp/extensions/*.ts",
    ".omp/test/*.mjs",

    "packages/*/test/**/*.{test,spec}.{ts,tsx}",
    "packages/*/test/**/*.type-test.ts",
    "packages/cli/bin/*.ts",
    "packages/cli/test/fixtures/**/*.ts",
    // Fake Codex programs the codex specs spawn by path.
    "packages/codex/test/fake-*.mjs",
    // A fake Claude Code CLI the claude-code settings spec spawns by path.
    "packages/claude-code/test/sdk/fake-*.mjs",

    "apps/kitchen-sink/flows/**/index.ts",
    // Docusaurus seeds the config, sidebars and pages, not this theme module.
    "apps/docs/src/prismThemes.ts",
    // MDX pages import these; no plugin follows an import out of a .md file.
    "apps/docs/src/components/**/index.tsx",
    // Vercel deploys each file under api/ as a Function; nothing imports them.
    "apps/build-site/api/*.js",

    "examples/*/test/**/*.{test,spec}.ts",
    // Neither a package.json entry nor seeded by the Next plugin.
    "examples/knowledge-base/src/okf/index.ts",

    "labs/knowledge-hub/src/index.ts",
    "labs/knowledge-hub/fsdev.config.ts",
    "labs/knowledge-hub/test/**/*.spec.ts",
    "labs/knowledge-hub/scripts/**/*.mts",
    "labs/teammates/fsdev.config.mts",

    // Loaded by `fsdev dev --config`, which no import reaches.
    "labs/claude-code-style/fsdev.config.mts",

    "plugins/flow-state-dev/test/**/*.test.mjs",
    "plugins/flow-state-dev/skills/install-fsd/detect/detect.mjs",

    "goals/scripts/*.mts"
  ],

  // Goals load their own files by path (the runnable check, fixtures, labs,
  // controls, legs: copied, spawned, or imported by URL), so no import edge
  // reaches them. The
  // goal-local glob needs a file below `goals/<describe>/<it>/`, which keeps
  // the shared `goals/lib` helpers analyzed like any module.
  "dynamicallyLoaded": [
    "goals/*/*/**/*.{ts,tsx,mts,mjs}",
    "goals/lib/module-patch*.mjs"
  ],

  // Not analyzed. Specs and their PoCs aren't workspace code, and
  // `goals/_template` is copied to start a new goal. The rest runs somewhere
  // else, so its imports resolve against that place's paths and dependencies:
  // goal harnesses and hosts run inside kitchen-sink, goal pages build inside an
  // app's scratch copy, install-fsd templates are copied into a user's project,
  // and packed-install fixtures run against a packed install.
  "ignorePatterns": [
    "!.omp/**",
    "spec-poc/**",
    "specs/**",
    "plugins/flow-state-dev/skills/install-fsd/templates/**",
    "scripts/packed-install/fixtures/**",
    // Files the docs brand lint reads to prove each rule can fail.
    "apps/docs/scripts/brand-lint-fixtures/**",
    "goals/_template/**",
    "goals/*/*/harness*.mts",
    "goals/*/*/host/**",
    // Goal pages copied into an app's scratch tree and built there by its Vite.
    "goals/*/*/pages/**",
    // flow-state.build is a static page: its HTML loads the stylesheet, which no import reaches.
    "apps/build-site/public/**"
  ],

  // Analyzed (their imports count) but never reported: vendored shadcn and
  // registry sources.
  "ignoreFindings": [
    "packages/ui/registry/**",
    "packages/ui/.storybook/shadcn/**",
    // The Claude Code-style lab's copies, as `fsdev ui add message` installed them.
    "labs/claude-code-style/src/components/ui/**",
    "labs/claude-code-style/src/components/flow-state/message.tsx",
    // and of the registry's review card, drawn for display only.
    "labs/claude-code-style/src/components/flow-state/review-hold.tsx",
    // Its copy of the registry's spend, as `fsdev ui add spend` installed it.
    "labs/claude-code-style/src/components/flow-state/spend.tsx",
    // and of the registry's tool grouping, which its tool lines read.
    "labs/claude-code-style/src/components/flow-state/tool-grouping.ts",
    // and of the registry's error, whose `ErrorDisplay` export its sheet doesn't draw.
    "labs/claude-code-style/src/components/flow-state/error.tsx",
    // The stock shadcn copies the Teammates lab and Shift Manager palettes are built on.
    "labs/teammates/src/components/ui/**",
    "packages/shift-manager/src/components/ui/command.tsx",
    "packages/shift-manager/src/components/ui/dialog.tsx",
    // The Teammates lab's copy of the registry's tool grouping.
    "labs/teammates/src/components/flow-state/tool-grouping.ts",
    // The Teammates lab's byte copy of the registry's spend: its card, popup and panel
    // draw the line and the totals; the copy's other formatters are for other apps.
    "labs/teammates/src/components/flow-state/spend.tsx",
    // and of the registry's review card, which the task popup draws.
    "labs/teammates/src/components/flow-state/review-hold.tsx",
    // and of the registry's error, whose `ErrorDisplay` export its task popup doesn't draw.
    "labs/teammates/src/components/flow-state/error.tsx",
    // The Teammates lab's byte copy of the registry's connection screen; its
    // backoff export is for apps that time their own retries.
    "labs/teammates/src/components/flow-state/connection-screen.tsx",
    // Kitchen Sink's and Shift Manager's byte-identical copies of the registry's
    // error.tsx, whose `ErrorBody` export is for `request-recovery`, which neither draws yet.
    "apps/kitchen-sink/components/flow-state/error.tsx",
    "packages/shift-manager/src/components/flow-state/error.tsx",
    // Kitchen Sink's copy of the registry's run-changes, which the registry
    // drift test requires installed; its Changes section imports it later.
    "apps/kitchen-sink/components/flow-state/run-changes.tsx",
    // Kitchen Sink's copy of the registry's run-checks, which the registry
    // drift test requires installed; its turn notice imports it later.
    "apps/kitchen-sink/components/flow-state/run-checks.tsx",
    // The labs' and Shift Manager's copies of the registry's run-checks: their
    // review-hold copies draw RunChecks; `runCheckPassed` is for apps that count apart.
    "labs/claude-code-style/src/components/flow-state/run-checks.tsx",
    "labs/teammates/src/components/flow-state/run-checks.tsx",
    "packages/shift-manager/src/components/flow-state/run-checks.tsx",
    // Kitchen Sink's byte copy of the registry's spend: its harness session draws
    // the line; the copy's other formatters are for apps that show them apart.
    "apps/kitchen-sink/components/flow-state/spend.tsx",
    // Kitchen Sink's installed copy of the work-place chip, before an app view imports it.
    "apps/kitchen-sink/components/flow-state/work-place.tsx",
    // Kitchen Sink's and Shift Manager's byte copies of the registry's review card:
    // their suspension cards import ReviewSuspension; the card's other exports are
    // for apps that draw holds.
    "apps/kitchen-sink/components/flow-state/review-hold.tsx",
    "packages/shift-manager/src/components/flow-state/review-hold.tsx",
    // Shift Manager's byte copy of the registry's spend: it draws the line and the
    // charge; the copy's other formatters are for apps that show them apart.
    "packages/shift-manager/src/components/flow-state/spend.tsx"
  ],

  // One named export, not a whole file. Kitchen Sink's and Shift Manager's byte
  // copies of the registry's tool-grouping carry `toolRunOpen`, the open-while-running
  // rule the labs follow (specs/issues/FIX-2393/SPEC.md, "One step-run state"); the
  // registry's own ToolGroup keeps its `defaultOpen` prop, so neither app calls it.
  "ignoreExports": [
    { "file": "apps/kitchen-sink/components/flow-state/tool-grouping.ts", "exports": ["toolRunOpen"] },
    { "file": "packages/shift-manager/src/components/flow-state/tool-grouping.ts", "exports": ["toolRunOpen"] },
    // The Teammates lab's copy of the registry's task-actions, with its Re-run buttons:
    // the confirm words and the cancel outcome are exported for tests and goals that read them off the page.
    { "file": "labs/teammates/src/components/flow-state/task-actions.tsx", "exports": ["CANCEL_CONFIRM", "cancelOutcome"] },
    // Shift Manager's byte copy of the registry's task-actions: the confirm words and
    // the cancel outcome are exported for tests and goals that read them off the page.
    { "file": "packages/shift-manager/src/components/flow-state/task-actions.tsx", "exports": ["CANCEL_CONFIRM", "cancelOutcome"] },
    // and the Claude Code-style lab's copy of it, for the same reason.
    { "file": "labs/claude-code-style/src/components/flow-state/task-actions.tsx", "exports": ["CANCEL_CONFIRM", "cancelOutcome"] }
  ],

  // Dead code fails `fallow audit` at its default severity. Complexity reports
  // but doesn't fail: existing hot spots are common enough that a new-only gate
  // would still fire on ordinary PRs. Duplication also reports without failing
  // (fallow's default, no `duplicates.threshold`): editing code inside an
  // existing clone splits it into clones fallow counts as new, so a failing
  // gate would block ordinary fixes to code that is already duplicated.
  "rules": {
    "complexity-cyclomatic": "warn",
    "complexity-cognitive": "warn",
    "complexity-crap": "warn"
  },

  // The host API the .omp extensions import; OMP supplies it at run time.
  "ignoreDependencies": ["@oh-my-pi/pi-coding-agent"]
}
