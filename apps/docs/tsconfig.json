{
  // Inlined from @docusaurus/tsconfig 3.10.2 minus `baseUrl`. FIX-2068 extends it again once that option is gone.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "strict": false,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  }
}
