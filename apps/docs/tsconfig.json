{
  // Inlined from @docusaurus/tsconfig 3.9.2 minus its `baseUrl`, which TS 6 deprecates and TS 7 removes.
  // FIX-2068 goes back to extending it once it drops `baseUrl`.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "strict": false,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  }
}
