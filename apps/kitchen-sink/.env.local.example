# OpenAI API key for the kitchen-sink example
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Persistence: DATABASE_URL takes priority when set (used by Vercel/Neon).
# Falls back to STORE_TYPE for local dev.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# When deployed on Vercel, VERCEL=1 is set automatically by the platform.
# That triggers two things in lib/server.ts:
#   1. Vercel-friendly pg.Pool defaults (short idle timeout, max: 1, ...) so
#      dead sockets from auto-suspended databases can't be reused across
#      cold-starts.
#   2. If DATABASE_URL points at *.neon.tech, the Neon WebSocket Client is
#      swapped in to cut the ~1–3s wake-up latency on the first request.
# Setting VERCEL=1 locally forces the same behavior for testing.

# Store type (local dev only, ignored when DATABASE_URL is set):
# "filesystem" persists sessions/users to .fsdev/data/, "memory" is ephemeral (default).
# STORE_TYPE=filesystem

# Redis URL for BullMQ background jobs (local dev only).
# Start Redis via: docker compose -f docker-compose.dev.yml up -d
# REDIS_URL=redis://localhost:6379
