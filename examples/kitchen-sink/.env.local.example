# OpenAI API key for the kitchen-sink example
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Persistence: DATABASE_URL takes priority when set (used by Vercel/Neon).
# Falls back to STORE_TYPE for local dev.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Store type (local dev only, ignored when DATABASE_URL is set):
# "filesystem" persists sessions/users to .fsdev/data/, "memory" is ephemeral (default).
# STORE_TYPE=filesystem
