{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "composite": false,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["lib/**/*.mts", "**/run.mts", "_template/*.mts", "harness-manager/host.mts"],
  "exclude": ["node_modules", "**/harness.mts"]
}
