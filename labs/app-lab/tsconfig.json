{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*", "test/**/*", "bin/**/*.mts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
