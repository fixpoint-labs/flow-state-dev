{
  "name": "@flow-state-dev/claude-code-style",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private lab: a Claude Code-style app on the workforce package. Sessions on the left, the main thread in the center, background tasks on the right. Built from config, React UI and small flows only.",
  "main": "./cli/index.ts",
  "exports": {
    ".": "./cli/index.ts"
  },
  "scripts": {
    "dev": "vite build && cd ../.. && tsx packages/cli/bin/fsdev.ts dev --config labs/claude-code-style/fsdev.config.mts --app @flow-state-dev/claude-code-style",
    "build": "vite build",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "test": "vitest run --root ."
  },
  "devDependencies": {
    "@flow-state-dev/claude-code": "workspace:*",
    "@flow-state-dev/client": "workspace:*",
    "@flow-state-dev/codex": "workspace:*",
    "@flow-state-dev/core": "workspace:*",
    "@flow-state-dev/design-system": "workspace:*",
    "@flow-state-dev/devtool": "workspace:*",
    "@flow-state-dev/engine": "workspace:*",
    "@flow-state-dev/fsdev": "workspace:*",
    "@flow-state-dev/harness-manager": "workspace:*",
    "@flow-state-dev/orchestration": "workspace:*",
    "@flow-state-dev/store-sqlite": "workspace:*",
    "@flow-state-dev/workforce": "workspace:*",
    "@flow-state-dev/workspace": "workspace:*",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.8.3",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "streamdown": "^2.3.0",
