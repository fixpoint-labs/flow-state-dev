{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*", "test/**/*", "cli/**/*.ts", "vite.config.ts", "vitest.config.ts", "vitest.layout.config.ts", "fsdev.config.mts", "host.mts", "workforce/**/*.mts"],
  "exclude": ["node_modules", "dist-client"]
}
