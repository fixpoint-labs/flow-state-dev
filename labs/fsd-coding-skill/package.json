    "@flow-state-dev/cursor": "workspace:*",
    "@flow-state-dev/engine": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@flow-state-dev/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
