{
  "name": "@flow-state-dev/fsd-coding-skill",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private lab: one FSD coding flow with four static doors and a host-selected Codex or Cursor harness. Drive it with `fsdev run`.",
