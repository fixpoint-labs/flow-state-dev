{
  "name": "@flow-state-dev/fsd-coding-skill",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Throwaway POC: one coding flow the outer agent must drive. Cursor harness, static doors, no Conductor/Workforce. Never merges as product API.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "implement": "tsx src/run.ts implement",
    "fix": "tsx src/run.ts fix",
    "open-pr": "tsx src/run.ts open-pr",
    "fix-fsd": "tsx src/run.ts fix-fsd"
  },
  "dependencies": {
    "@flow-state-dev/core": "workspace:*",
    "@flow-state-dev/cursor": "workspace:*",
    "@flow-state-dev/engine": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@flow-state-dev/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
