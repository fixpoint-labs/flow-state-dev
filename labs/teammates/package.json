{
  "name": "@flow-state-dev/teammates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private lab: a Grok Bot-style app on the workforce package. A list of workers on the left, each with one long conversation; workers message each other where you can see it. Built from config, React UI and small flows only.",
  "main": "./cli/index.ts",
  "exports": {
    ".": "./cli/index.ts"
  },
  "scripts": {
    "dev": "vite build && tsx ../../packages/cli/bin/fsdev.ts dev --app @flow-state-dev/teammates",
    "build": "vite build",
    "fsdev": "tsx ../../packages/cli/bin/fsdev.ts",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "test": "vitest run --root .",
    "inventory": "node scripts/inventory.mjs",
    "inventory:write": "node scripts/inventory.mjs --write",
    "inventory:control": "node scripts/inventory.mjs --control"
  },
  "devDependencies": {
    "@flow-state-dev/design-system": "workspace:*",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "happy-dom": "^20.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.12",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@flow-state-dev/claude-code": "workspace:*",
    "@flow-state-dev/client": "workspace:*",
    "@flow-state-dev/codex": "workspace:*",
    "@flow-state-dev/core": "workspace:*",
    "@flow-state-dev/devtool": "workspace:*",
    "@flow-state-dev/engine": "workspace:*",
    "@flow-state-dev/fsdev": "workspace:*",
    "@flow-state-dev/harness-manager": "workspace:*",
    "@flow-state-dev/memory": "workspace:*",
    "@flow-state-dev/orchestration": "workspace:*",
    "@flow-state-dev/store-sqlite": "workspace:*",
    "@flow-state-dev/workforce": "workspace:*",
    "@flow-state-dev/workspace": "workspace:*",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "streamdown": "^2.3.0",
    "zod": "^3.24.1"
  }
}
