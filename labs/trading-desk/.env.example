# Postgres connection for the trading-desk (FIX-772).
#
# Leave UNSET for local dev: the app runs on an embedded PGlite database
# (Postgres compiled to WASM), persisted under .fsdev/pglite — no Docker, and
# data survives `pnpm dev` restarts. The app.* migrations apply in process.
#
# Set this in deployment to use a real Postgres, and run the migrate step first:
#   pnpm --filter @flow-state-dev/trading-desk migrate
# FSD_DB_URL takes precedence over DATABASE_URL if both are set.
# DATABASE_URL=postgres://user:pass@host:5432/trading_desk
