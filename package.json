{
  "name": "flow-state-dev",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "install:all": "pnpm install",
    "build": "turbo run build && pnpm build:assets",
    "build:assets": "pnpm --filter @flow-state-dev/devtool build:assets",
    "typecheck": "turbo run typecheck && node scripts/validate-package-boundaries.mjs && node scripts/validate-updater-purity.mjs && node scripts/validate-side-chain-vocabulary.mjs && node scripts/validate-test-typecheck.mjs && pnpm --filter @flow-state-dev/goals guard:control-shape",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "prepare": "husky",
    "fallow": "fallow",
    "fallow:ci": "fallow dead-code --unresolved-imports --unlisted-deps",
    "fallow:audit": "fallow audit",
    "fallow:new-dead-code": "node scripts/check-new-dead-code.mjs",
    "test": "turbo run test --concurrency=1",
    "test:watch": "pnpm -r --parallel --stream --if-present test:watch",
    "packages:build": "turbo run build --filter=\"./packages/*\"",
    "release:build": "pnpm packages:build && pnpm build:assets",
    "devtool:dev": "pnpm --filter @flow-state-dev/devtool-app dev",
    "docs:dev": "pnpm --filter @flow-state-dev/docs dev",
    "docs:build": "pnpm --filter @flow-state-dev/docs build",
    "docs:serve": "pnpm --filter @flow-state-dev/docs serve",
    "storybook": "pnpm --filter @flow-state-dev/ui storybook",
    "kitchen-sink:dev": "pnpm --filter @flow-state-dev/kitchen-sink dev",
    "shift-manager:dev": "pnpm --filter @flow-state-dev/shift-manager dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm release:build && changeset publish --provenance",
    "release:ci": "pnpm release:build && bash -eo pipefail -c 'if [ -n \"${NPM_TOKEN:-}\" ]; then changeset publish --provenance; else echo \"Skipping npm publish in CI: NPM_TOKEN is not set\"; fi'",
    "release:snapshot": "changeset version --snapshot && pnpm release:build && changeset publish --tag canary --no-git-tag --provenance",
    "fsdev": "tsx packages/cli/bin/fsdev.ts",
    "goal:all": "pnpm --filter @flow-state-dev/goals goal:all"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@anthropic-ai/claude-agent-sdk": "^0.3.234"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.39.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fallow": "^3.33.1",
    "husky": "^9.1.7",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "turbo": "^2.9.16",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  }
}
