{
  "name": "flow-state-dev",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "install:all": "pnpm install",
    "typecheck": "pnpm -r --if-present typecheck && node scripts/validate-package-boundaries.mjs",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --parallel --stream --if-present test:watch",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "devtool:dev": "pnpm --filter @flow-state-dev/react build && node scripts/devtool-dev.mjs",
    "docs:dev": "pnpm --filter @flow-state-dev/docs dev",
    "docs:build": "pnpm --filter @flow-state-dev/docs build",
    "docs:serve": "pnpm --filter @flow-state-dev/docs serve",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter \"./packages/*\" -r build && changeset publish --provenance",
    "release:ci": "pnpm --filter \"./packages/*\" -r build && bash -eo pipefail -c 'if [ -n \"${NPM_TOKEN:-}\" ]; then changeset publish --provenance; else echo \"Skipping npm publish in CI: NPM_TOKEN is not set\"; fi'",
    "release:snapshot": "changeset version --snapshot && pnpm --filter \"./packages/*\" -r build && changeset publish --tag canary --no-git-tag --provenance",
    "fsdev": "tsx packages/cli/bin/fsdev.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@changesets/cli": "^2.29.5"
  }
}
