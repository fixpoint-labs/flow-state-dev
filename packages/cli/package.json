{
  "name": "@flow-state-dev/cli",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@flow-state-dev/core": "workspace:*",
    "@flow-state-dev/server": "workspace:*",
    "@flow-state-dev/store-sqlite": "workspace:*",
    "@flow-state-dev/testing": "workspace:*",
    "commander": "^13.1.0"
  },
  "peerDependencies": {
    "@flow-state-dev/devtool": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@flow-state-dev/devtool": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flow-state-dev/devtool": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.4",
    "zod": "^4.3.6"
  },
  "bin": {
    "fsdev": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "fsdev": "tsx src/bin.ts"
  }
}
