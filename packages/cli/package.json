{
  "name": "@flow-state-dev/cli",
  "version": "0.0.0",
  "description": "The fsdev command-line interface for flow-state-dev.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
    "cli",
    "fsdev",
    "terminal"
  ],
  "homepage": "https://flow-state.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixpoint-labs/flow-state-dev.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/fixpoint-labs/flow-state-dev/issues"
  },
  "author": "Fixpoint Labs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "fsdev": "./dist/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "dependencies": {
    "@flow-state-dev/core": "workspace:*",
    "@flow-state-dev/node": "workspace:*",
    "@flow-state-dev/engine": "workspace:*",
    "@flow-state-dev/store-sqlite": "workspace:*",
    "@flow-state-dev/testing": "workspace:*",
    "commander": "^13.1.0"
  },
  "peerDependencies": {
    "@flow-state-dev/devtool": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@flow-state-dev/devtool": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flow-state-dev/devtool": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.4",
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "fsdev": "tsx src/bin.ts"
  }
}
