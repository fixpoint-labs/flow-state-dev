{
  "name": "@flow-state-dev/codex",
  "version": "0.1.1",
  "description": "Codex integration for flow-state-dev: run OpenAI's Codex agent as a block through the Codex SDK.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
    "codex",
    "openai"
  ],
  "homepage": "https://flow-state.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixpoint-labs/flow-state-dev.git",
    "directory": "packages/codex"
  },
  "bugs": {
    "url": "https://github.com/fixpoint-labs/flow-state-dev/issues"
  },
  "author": "Fixpoint Labs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "dependencies": {
    "@flow-state-dev/core": "workspace:*",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@openai/codex-sdk": "0.164.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flow-state-dev/testing": "workspace:*",
    "@openai/codex-sdk": "0.164.0",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/add-esm-extensions.mjs dist",
    "typecheck": "node ../../scripts/typecheck.mjs && tsc -p tsconfig.test-d.json",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
  }
}
