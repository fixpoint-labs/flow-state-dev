{
  "name": "@flow-state-dev/core",
  "version": "0.0.0",
  "description": "Isomorphic builders, type contracts, and item taxonomy for the flow-state-dev block framework.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
    "blocks",
    "items",
    "zod",
    "schema"
  ],
  "homepage": "https://flow-state.dev",
