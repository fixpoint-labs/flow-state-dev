{
  "name": "@flow-state-dev/devtool",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css"
  },
  "license": "MIT",
  "files": [
    "dist",
    "dist-client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@flow-state-dev/client": "workspace:*",
    "@flow-state-dev/core": "workspace:*",
    "@flow-state-dev/react": "workspace:*",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "happy-dom": "^20.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
