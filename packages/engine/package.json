{
  "name": "@flow-state-dev/engine",
  "version": "0.0.0",
  "description": "Execution runtime, stores, SSE streaming, and HTTP routes for flow-state-dev.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
    "server",
    "runtime",
    "sse",
    "streaming"
  ],
  "homepage": "https://flow-state.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixpoint-labs/flow-state-dev.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/fixpoint-labs/flow-state-dev/issues"
  },
  "author": "Fixpoint Labs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./prompt-file": {
      "types": "./dist/prompt-file-loader.d.ts",
      "default": "./src/prompt-file-loader.ts"
    },
    "./resource-template": {
      "types": "./dist/resource-template-loader.d.ts",
      "default": "./src/resource-template-loader.ts"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./prompt-file": {
        "types": "./dist/prompt-file-loader.d.ts",
        "default": "./dist/prompt-file-loader.js"
      },
      "./resource-template": {
        "types": "./dist/resource-template-loader.d.ts",
        "default": "./dist/resource-template-loader.js"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@flow-state-dev/core": "workspace:*",
    "p-retry": "^6.2.0",
    "path-to-regexp": "^8.2.0"
  },
  "peerDependencies": {
    "vitest": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flow-state-dev/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "ai": "^7.0.15",
    "zod": "^3.25.76"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
  }
}
