{
  "name": "@flow-state-dev/mcp",
  "version": "0.0.0",
  "description": "MCP transport adapter for flow-state-dev.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
