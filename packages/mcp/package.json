  "devDependencies": {
    "@flow-state-dev/testing": "workspace:*",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
