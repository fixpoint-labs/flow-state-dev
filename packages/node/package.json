{
  "name": "@flow-state-dev/node",
  "version": "0.0.0",
  "description": "Node HTTP host adapter for flow-state-dev — serve a long-lived FSD server in one call.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
    "node",
    "http",
    "server",
    "sse",
    "self-host"
  ],
  "homepage": "https://flow-state.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixpoint-labs/flow-state-dev.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/fixpoint-labs/flow-state-dev/issues"
  },
  "author": "Fixpoint Labs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./src/app.ts"
    },
    "./aws-lambda": {
      "types": "./dist/aws-lambda.d.ts",
      "default": "./src/aws-lambda.ts"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./app": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.js"
      },
      "./aws-lambda": {
        "types": "./dist/aws-lambda.d.ts",
        "default": "./dist/aws-lambda.js"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "dependencies": {
    "@flow-state-dev/engine": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@flow-state-dev/core": "workspace:*",
    "@flow-state-dev/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "zod": "^3.24.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
  }
}
