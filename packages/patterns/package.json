{
  "name": "@flow-state-dev/patterns",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rlm": {
      "types": "./dist/rlm/index.d.ts",
      "default": "./dist/rlm/index.js"
    },
    "./coordinator": {
      "types": "./dist/coordinator/index.d.ts",
      "default": "./dist/coordinator/index.js"
    }
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@flow-state-dev/core": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@flow-state-dev/testing": "workspace:*",
    "vitest": "^3.2.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "lint": "echo 'lint not configured yet'",
    "test": "pnpm --filter @flow-state-dev/testing build && vitest run --root .",
    "test:watch": "vitest --root ."
  }
}
