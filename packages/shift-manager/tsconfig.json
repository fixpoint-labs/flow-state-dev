{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    // The registry copies import `@/…` (components.json's aliases). Relative to
    // the base config's baseUrl, the repo root. Setting `paths` here replaces
    // the base's source mappings, so workspace packages resolve through their
    // package exports instead.
    "paths": { "@/*": ["./packages/shift-manager/src/*"] }
  },
  "include": ["src/**/*", "test/**/*", "cli/**/*.ts", "scripts/**/*.mts", "teams/**/*.mts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "dist-client"]
}
