{
  "name": "@thought-fabric/core",
  "version": "0.0.1",
  "description": "Cognitive architecture primitives built on flow-state-dev.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
    "thought-fabric",
    "attention",
    "identity",
    "cognitive"
  ],
  "homepage": "https://flow-state.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixpoint-labs/flow-state-dev.git",
    "directory": "packages/thought-fabric-core"
  },
  "bugs": {
    "url": "https://github.com/fixpoint-labs/flow-state-dev/issues"
  },
  "author": "Fixpoint Labs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./attention": {
      "types": "./dist/attention/index.d.ts",
      "default": "./src/attention/index.ts"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "default": "./src/identity/index.ts"
    },
    "./metacognition": {
      "types": "./dist/metacognition/index.d.ts",
      "default": "./src/metacognition/index.ts"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./attention": {
        "types": "./dist/attention/index.d.ts",
        "default": "./dist/attention/index.js"
      },
      "./identity": {
        "types": "./dist/identity/index.d.ts",
        "default": "./dist/identity/index.js"
      },
      "./metacognition": {
        "types": "./dist/metacognition/index.d.ts",
        "default": "./dist/metacognition/index.js"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
  },
  "dependencies": {
    "zod": "^3.24.1",
    "@flow-state-dev/core": "workspace:*"
  },
  "devDependencies": {
    "@flow-state-dev/testing": "workspace:*"
  }
}
