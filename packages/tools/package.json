{
  "name": "@flow-state-dev/tools",
  "version": "0.0.0",
  "description": "Reusable tool blocks for flow-state-dev.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
    "tools",
    "blocks",
    "mcp"
  ],
  "homepage": "https://flow-state.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixpoint-labs/flow-state-dev.git",
    "directory": "packages/tools"
  },
  "bugs": {
    "url": "https://github.com/fixpoint-labs/flow-state-dev/issues"
  },
  "author": "Fixpoint Labs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "default": "./src/search/index.ts"
    },
    "./fetch": {
      "types": "./dist/fetch/index.d.ts",
      "default": "./src/fetch/index.ts"
    },
    "./crawl": {
      "types": "./dist/crawl/index.d.ts",
      "default": "./src/crawl/index.ts"
    },
    "./bash": {
      "types": "./dist/bash/index.d.ts",
      "default": "./src/bash/index.ts"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./src/mcp/index.ts"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./search": {
        "types": "./dist/search/index.d.ts",
        "default": "./dist/search/index.js"
      },
      "./fetch": {
        "types": "./dist/fetch/index.d.ts",
        "default": "./dist/fetch/index.js"
      },
      "./crawl": {
        "types": "./dist/crawl/index.d.ts",
        "default": "./dist/crawl/index.js"
      },
      "./bash": {
        "types": "./dist/bash/index.d.ts",
        "default": "./dist/bash/index.js"
      },
      "./mcp": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "dependencies": {
    "@flow-state-dev/core": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.15",
    "linkedom": "^0.18.12",
    "shell-quote": "^1.8.3",
    "turndown": "^7.2.4",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@ai-sdk/mcp": "^2.0.7",
    "@mendable/firecrawl-js": "^1.15.0",
    "@tavily/core": "^0.7.0",
    "exa-js": "^1.5.0",
    "just-bash": "^2.14.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/mcp": {
      "optional": true
    },
    "@tavily/core": {
      "optional": true
    },
    "exa-js": {
      "optional": true
    },
    "@mendable/firecrawl-js": {
      "optional": true
    },
    "just-bash": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/mcp": "^2.0.7",
    "@flow-state-dev/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/shell-quote": "^1.7.5",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "lint": "echo 'lint not configured yet'",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
  }
}
