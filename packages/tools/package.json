{
  "name": "@flow-state-dev/tools",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch/index.d.ts",
      "default": "./dist/fetch/index.js"
    },
    "./crawl": {
      "types": "./dist/crawl/index.d.ts",
      "default": "./dist/crawl/index.js"
    },
    "./bash": {
      "types": "./dist/bash/index.d.ts",
      "default": "./dist/bash/index.js"
    }
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@flow-state-dev/core": "workspace:*",
    "ai": "^6.0.93",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.4",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@mendable/firecrawl-js": "^1.15.0",
    "@tavily/core": "^0.7.0",
    "exa-js": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@tavily/core": {
      "optional": true
    },
    "exa-js": {
      "optional": true
    },
    "@mendable/firecrawl-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flow-state-dev/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "lint": "echo 'lint not configured yet'",
    "test": "pnpm --filter @flow-state-dev/testing build && vitest run --root .",
    "test:watch": "vitest --root ."
  }
}
