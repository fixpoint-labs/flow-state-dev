{
  "name": "@flow-state-dev/vercel",
  "version": "0.0.0",
  "description": "Vercel deployment adapter for flow-state-dev.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
    "vercel",
    "deployment",
    "sse",
    "heartbeat"
  ],
  "homepage": "https://flow-state.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixpoint-labs/flow-state-dev.git",
    "directory": "packages/vercel"
  },
  "bugs": {
    "url": "https://github.com/fixpoint-labs/flow-state-dev/issues"
  },
  "author": "Fixpoint Labs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "default": "./src/pg.ts"
    },
    "./schedules": {
      "types": "./dist/schedules.d.ts",
      "default": "./src/schedules.ts"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./src/store.ts"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./src/next.ts"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./pg": {
        "types": "./dist/pg.d.ts",
        "default": "./dist/pg.js"
      },
      "./schedules": {
        "types": "./dist/schedules.d.ts",
        "default": "./dist/schedules.js"
      },
      "./store": {
        "types": "./dist/store.d.ts",
        "default": "./dist/store.js"
      },
      "./next": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "dependencies": {
    "@flow-state-dev/engine": "workspace:*",
    "@flow-state-dev/store-postgres": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "pg": "^8.13.0"
  },
  "peerDependencies": {
    "@flow-state-dev/scheduled": "workspace:*",
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flow-state-dev/scheduled": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
  }
}
