{
  "name": "@flow-state-dev/workforce",
  "version": "0.4.0",
  "description": "The worker factory for flow-state-dev: worker records become configured workers.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "workflow",
    "typescript",
    "flow-state-dev",
    "workforce",
    "agent"
  ],
  "homepage": "https://flow-state.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixpoint-labs/flow-state-dev.git",
    "directory": "packages/workforce"
  },
  "bugs": {
    "url": "https://github.com/fixpoint-labs/flow-state-dev/issues"
  },
  "author": "Fixpoint Labs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./src/browser.ts"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "default": "./src/loader/index.ts"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./src/codegen/index.ts"
    },
    "./fsdev-gen": {
      "types": "./dist/codegen/fsdev-gen.d.ts",
      "default": "./src/codegen/fsdev-gen.ts"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./loader": {
        "types": "./dist/loader/index.d.ts",
        "default": "./dist/loader/index.js"
      },
      "./codegen": {
        "types": "./dist/codegen/index.d.ts",
        "default": "./dist/codegen/index.js"
      },
      "./fsdev-gen": {
        "types": "./dist/codegen/fsdev-gen.d.ts",
        "default": "./dist/codegen/fsdev-gen.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "dependencies": {
    "@flow-state-dev/client": "workspace:*",
    "@flow-state-dev/core": "workspace:*",
    "@flow-state-dev/orchestration": "workspace:*",
    "@flow-state-dev/scheduled": "workspace:*",
    "@flow-state-dev/tools": "workspace:*",
    "@flow-state-dev/workspace": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@flow-state-dev/engine": "workspace:*",
    "@flow-state-dev/memory": "workspace:*",
    "@flow-state-dev/store-sqlite": "workspace:*",
    "@flow-state-dev/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "cron-parser": "^5.5.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/add-esm-extensions.mjs dist",
    "typecheck": "node ../../scripts/typecheck.mjs && tsc -p tsconfig.test-d.json && tsc -p tsconfig.test-d-strict.json",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
  }
}
