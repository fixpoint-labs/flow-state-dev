{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "composite": false,
    "paths": {
      "zod": ["packages/core/node_modules/zod"],
      "@flow-state-dev/contracts": ["packages/contracts/src/index.ts"],
      "@flow-state-dev/contracts/items": ["packages/contracts/src/items/index.ts"],
      "@flow-state-dev/contracts/items/*": ["packages/contracts/src/items/*"],
      "@flow-state-dev/contracts/block-instance-id": ["packages/contracts/src/block-instance-id.ts"],
      "@flow-state-dev/contracts/types/*": ["packages/contracts/src/types/*"],
      "@flow-state-dev/contracts/helpers": ["packages/contracts/src/helpers/index.ts"],
      "@flow-state-dev/contracts/helpers/*": ["packages/contracts/src/helpers/*"],
      "@flow-state-dev/core": ["packages/core/src/index.ts"],
      "@flow-state-dev/core/types": ["packages/core/src/types/index.ts"],
      "@flow-state-dev/core/items": ["packages/core/src/items/index.ts"],
      "@flow-state-dev/core/items/internal": ["packages/core/src/items/internal.ts"],
      "@flow-state-dev/core/models": ["packages/core/src/models/index.ts"],
      "@flow-state-dev/core/helpers": ["packages/core/src/helpers/index.ts"],
      "@flow-state-dev/engine": ["packages/engine/src/index.ts"],
      "@flow-state-dev/engine/testing": ["packages/engine/src/testing.ts"],
      "@flow-state-dev/engine/prompt-file": ["packages/engine/src/prompt-file-loader.ts"],
      "@flow-state-dev/engine/resource-template": ["packages/engine/src/resource-template-loader.ts"],
      "@flow-state-dev/client": ["packages/client/src/index.ts"],
      "@flow-state-dev/testing": ["packages/testing/src/index.ts"],
      "@flow-state-dev/orchestration": ["packages/orchestration/src/index.ts"],
      "@flow-state-dev/orchestration/tasks": ["packages/orchestration/src/tasks/index.ts"],
      "@flow-state-dev/orchestration/task-board": ["packages/orchestration/src/task-board/index.ts"]
    }
  },
  "include": ["./*.ts"]
}
