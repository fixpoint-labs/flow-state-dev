   name: "background-brief",
   script: sideChainBriefScript,
 });
+
+/**
+ * POC (FIX-1589): the clerk's generator. `[scenario:clerk-answer]` answers in
+ * words the note does not contain; `[scenario:clerk-file]` files the note onto
+ * escalations through the real tool, then says so.
+ */
+function buildDeskClerkMock(): MockGeneratorInstance {
+  const cursors = new Map<string, number>();
+  return {
+    name: "desk-clerk-answer",
+    calls: [],
+    next: (input?: unknown) => {
+      const json = JSON.stringify(input ?? "");
+      if (json.includes("[scenario:clerk-file]")) {
+        const token = /clerk-token-[a-z0-9]+/.exec(json)?.[0] ?? "no-token";
+        const i = cursors.get(token) ?? 0;
+        cursors.set(token, i + 1);
+        return i === 0
+          ? { toolCalls: [{ toolCallId: `tc_${token}`, toolName: "desk-clerk-file", args: { board: "escalations", goal: `Escalated: ${token}` } }] }
+          : { text: "[clerk:filed] Filed onto escalations." };
+      }
+      if (json.includes("[scenario:clerk-answer]")) {
+        return { text: "[clerk:answered] The front desk has your note." };
+      }
+      return { text: "Test mode (no clerk scenario matched)." };
+    },
+    reset: () => cursors.clear(),
+  };
+}
+
+export const deskClerkMock = buildDeskClerkMock();
