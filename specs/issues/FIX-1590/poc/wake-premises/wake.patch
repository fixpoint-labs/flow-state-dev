+// ---------------------------------------------------------------------------
+// POC FIX-1590: the wake. One declared dispatcher per agent member, chosen by
+// a router; everything else falls to the name-only line above.
+// ---------------------------------------------------------------------------
+/** The kind column the wake reads (POC stand-in for FIX-1585 D3's map). */
+const WAKE_ACTION: Record<string, string | undefined> = {
+  agent: "onChannelPost",
+  "desk-clerk": undefined,
+  "followup-runner": undefined,
+};
+
+export function notifyFor(seats: readonly { id: string; kind: string }[]) {
+  const wakes = new Map(
+    seats.flatMap((seat) => {
+      const action = WAKE_ACTION[seat.kind];
+      if (action === undefined) return [];
+      return [[seat.id, dispatcher({
+        name: `wake-${seat.id}`,
+        flowKind: seat.id,
+        action,
+        inputSchema: channelNotifyInputSchema,
+        // One conversation per seat per channel, adopted on every post.
+        session: { key: (input: ChannelNotifyInput) => `channel:${input.channelId}` },
+      })] as const];
+    }),
+  );
+  return router({
+    name: "kitchen-sink-notify",
+    inputSchema: channelNotifyInputSchema,
+    routes: [notifyMember, ...wakes.values()] as never,
+    execute: (input: ChannelNotifyInput) => {
+      // A post a seat wrote wakes no seat (epic D2).
+      if (input.author !== undefined && process.env.POC_NO_FILTER !== "1") return notifyMember as never;
+      return (wakes.get(input.member) ?? notifyMember) as never;
+    },
+  });
+}
+
 export default notifyMember;
