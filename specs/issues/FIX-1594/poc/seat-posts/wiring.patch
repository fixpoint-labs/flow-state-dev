index 000000000..3793ab34c
--- /dev/null
+++ b/apps/kitchen-sink/test/poc-agent-mock.ts
@@ -0,0 +1,27 @@
+/**
+ * POC (FIX-1594) — throwaway scripted model for the agent kind's generator.
+ * A message carrying `[poc:reply <channel>]` gets one tool call to
+ * `post-to-channel` (no text, so the real tool runs), then a text reply.
+ * `[poc:forge]` adds an `author` argument the tool must not accept.
+ */
+import type { MockGeneratorInstance, MockGeneratorScriptStep } from "@flow-state-dev/testing";
+
+const seen = new Map<string, number>();
+const calls: MockGeneratorInstance["calls"] = [];
+
+export const pocAgentMock: MockGeneratorInstance = {
+  name: "agent-answer",
+  calls,
+  reset: () => seen.clear(),
+  next: (input?: unknown): MockGeneratorScriptStep => {
+    const json = JSON.stringify(input ?? "");
+    const match = /\[poc:reply ([a-z0-9.\-]+)\]/.exec(json);
+    if (match === null) return { text: "Agent test mode (no poc marker)." };
+    const n = seen.get(json) ?? 0;
+    seen.set(json, n + 1);
+    if (n > 0) return { text: `Posted to ${match[1]}.` };
+    const args: Record<string, unknown> = { channel: match[1], body: `otto answers [poc:reply-line ${Date.now()}]` };
+    if (json.includes("[poc:forge]")) args.author = "support.iris";
+    return { toolCalls: [{ toolCallId: `tc_${Date.now()}`, toolName: "post-to-channel", args }] };
+  },
+};
