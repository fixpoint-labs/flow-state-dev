diff --git a/apps/kitchen-sink/workforce/poc-seat-posts.ts b/apps/kitchen-sink/workforce/poc-seat-posts.ts
new file mode 100644
index 000000000..8c3aef34d
--- /dev/null
+++ b/apps/kitchen-sink/workforce/poc-seat-posts.ts
@@ -0,0 +1,61 @@
+/**
+ * POC (FIX-1594) — throwaway. The smallest shape of "an agent seat posts to a
+ * channel it belongs to": a tool that takes only `{ channel, body }` from the
+ * model, reads the author from the seat's own settings (imposed by the hire),
+ * and dispatches the channel's own `post` into that channel's session.
+ *
+ * Also a POC stand-in for FIX-1590's wake: a notify slot that, for a post with
+ * no author, dispatches the post into `support.otto`'s receiver.
+ */
+import { dispatcher, sequencer } from "@flow-state-dev/core";
+import { channelNotifyInputSchema, type ChannelNotifyInput } from "@flow-state-dev/workforce";
+import { z } from "zod";
+import notifyMember from "./channel-notify";
+
+const g = globalThis as { __pocOttoSession?: string; __pocDropAuthor?: boolean };
+
+const postIntoChannel = dispatcher({
+  name: "poc-post-into-channel",
+  flowKind: "channel",
+  action: "post",
+  inputSchema: z.object({ channel: z.string(), body: z.string(), author: z.string().optional() }),
+  session: { id: (input) => input.channel },
+  payload: (input) => ({ body: input.body, ...(input.author === undefined ? {} : { author: input.author }) }),
+});
+
+/** The tool. The model supplies the channel and the words; never the author. */
+export const postToChannel = sequencer({
+  name: "post-to-channel",
+  description: "Post a line to a channel you belong to, under your own name.",
+  inputSchema: z.object({ channel: z.string().min(1), body: z.string().min(1) }).strict(),
+}).step(
+  (input: { channel: string; body: string }, ctx) => ({
+    channel: input.channel,
+    body: input.body,
+    // Server-set: the hire wrote it from the record. NEGATIVE control drops it.
+    ...(g.__pocDropAuthor === true
+      ? {}
+      : { author: (ctx.flow.config as { seatId?: string }).seatId }),
+  }),
+  postIntoChannel,
+);
+
+const wakeOtto = dispatcher({
+  name: "poc-wake-otto",
+  flowKind: "support.otto",
+  action: "receive",
+  inputSchema: channelNotifyInputSchema,
+  session: { id: () => g.__pocOttoSession ?? "missing" },
+  payload: (input: ChannelNotifyInput) => ({
+    message: `A post in ${input.channelId}: ${input.body}`,
+  }),
+});
+
+/** The notify slot: the app's stub, plus the POC wake for otto on an author-less post. */
+export const pocNotify = sequencer({ name: "poc-notify", inputSchema: channelNotifyInputSchema })
+  .tap(notifyMember)
+  .tapIf(
+    (input: ChannelNotifyInput) =>
+      input.member === "support.otto" && input.author === undefined && g.__pocOttoSession !== undefined,
+    wakeOtto,
+  );
