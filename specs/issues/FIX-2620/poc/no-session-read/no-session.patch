+/** POC (no-session view): what reaching for a session throws in a view with none. */
+export class NoSessionError extends Error {
+  constructor(what: string) {
+    super(`This view runs with no session: it can't ${what}`);
+    this.name = "NoSessionError";
+  }
+}
+/** POC: stands where `ctx.session` would, and refuses every use. */
+function noSessionHandle(): never {
+  return new Proxy({}, {
+    get(_t, prop) {
+      if (typeof prop === "symbol" || prop === "then") return undefined;
+      throw new NoSessionError(`use ctx.session (${prop})`);
+    }
+  }) as never;
+}
+/** POC: stands where the session record would, and refuses every use. */
+function noSessionRecord(): SessionRecord {
+  return new Proxy({} as SessionRecord, {
+    get(_t, prop) {
+      if (typeof prop === "symbol" || prop === "then") return undefined;
+      throw new NoSessionError(`read the session record (${prop})`);
+    }
+  });
+}
