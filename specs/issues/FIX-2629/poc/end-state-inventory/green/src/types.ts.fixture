import type { ViewOutput } from "@flow-state-dev/client";
import type { workerSessions } from "@flow-state-dev/workforce";
import type { codingBoard } from "@flow-state-dev/harness-manager";
export type LabTask = ViewOutput<typeof codingBoard>[number];
