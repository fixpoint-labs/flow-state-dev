{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@flow-state-dev/contracts": ["packages/contracts/src/index.ts"],
      "@flow-state-dev/contracts/items": ["packages/contracts/src/items/index.ts"],
      "@flow-state-dev/contracts/items/*": ["packages/contracts/src/items/*"],
      "@flow-state-dev/contracts/block-instance-id": ["packages/contracts/src/block-instance-id.ts"],
      "@flow-state-dev/contracts/types/*": ["packages/contracts/src/types/*"],
      "@flow-state-dev/contracts/helpers": ["packages/contracts/src/helpers/index.ts"],
      "@flow-state-dev/contracts/helpers/*": ["packages/contracts/src/helpers/*"],
      "@flow-state-dev/core": ["packages/core/src/index.ts"],
      "@flow-state-dev/core/types": ["packages/core/src/types/index.ts"],
      "@flow-state-dev/core/items": ["packages/core/src/items/index.ts"],
      "@flow-state-dev/core/items/internal": ["packages/core/src/items/internal.ts"],
      "@flow-state-dev/core/models": ["packages/core/src/models/index.ts"],
      "@flow-state-dev/core/helpers": ["packages/core/src/helpers/index.ts"],
      "@flow-state-dev/engine": ["packages/engine/src/index.ts"],
      "@flow-state-dev/engine/testing": ["packages/engine/src/testing.ts"],
      "@flow-state-dev/engine/prompt-file": ["packages/engine/src/prompt-file-loader.ts"],
      "@flow-state-dev/engine/resource-template": ["packages/engine/src/resource-template-loader.ts"],
      "@flow-state-dev/client": ["packages/client/src/index.ts"],
      "@flow-state-dev/react": ["packages/react/src/index.ts"],
      "@flow-state-dev/testing": ["packages/testing/src/index.ts"],
      "@flow-state-dev/mcp": ["packages/mcp/src/index.ts"],
      "@flow-state-dev/scheduled": ["packages/scheduled/src/index.ts"],
      "@flow-state-dev/scheduled/testing": ["packages/scheduled/src/testing.ts"],
      "@flow-state-dev/chat-sdk": ["packages/chat-sdk/src/index.ts"],
      "@flow-state-dev/chat-sdk/testing": ["packages/chat-sdk/src/testing.ts"],
      "@flow-state-dev/cli": ["packages/cli/src/index.ts"],
      "@flow-state-dev/patterns": ["packages/patterns/src/index.ts"],
      "@flow-state-dev/patterns/rlm": ["packages/patterns/src/rlm/index.ts"],
      "@flow-state-dev/tasks": ["packages/tasks/src/index.ts"],
      "@flow-state-dev/tools": ["packages/tools/src/index.ts"],
      "@flow-state-dev/tools/search": ["packages/tools/src/search/index.ts"],
      "@flow-state-dev/tools/fetch": ["packages/tools/src/fetch/index.ts"],
      "@flow-state-dev/tools/crawl": ["packages/tools/src/crawl/index.ts"],
      "@flow-state-dev/tools/bash": ["packages/tools/src/bash/index.ts"],
      "@flow-state-dev/ui/generative/renderers": ["packages/ui/src/generative/renderers.ts"],
      "@flow-state-dev/ui/generative/tools": ["packages/ui/src/generative/tools.ts"],
      "@flow-state-dev/devtool": ["packages/devtool/src/index.ts"],
      "@flow-state-dev/devtool/react": ["packages/devtool/src/react/index.ts"],
      "@flow-state-dev/store-sqlite": ["packages/store-sqlite/src/index.ts"],
      "@flow-state-dev/vercel": ["packages/vercel/src/index.ts"],
      "@flow-state-dev/vercel/schedules": ["packages/vercel/src/schedules.ts"],
      "@flow-state-dev/voice-openai": ["packages/voice-openai/src/index.ts"],
      "@thought-fabric/core": ["packages/thought-fabric-core/src/index.ts"]
    }
  }
}
