{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "scripts/vitest-isolation.mjs", "scripts/typecheck.mjs", "scripts/typecheck-programs.mjs", "scripts/validate-test-typecheck.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "dist-client/**",
        "tsconfig.tsbuildinfo",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@flow-state-dev/engine#build": {
      "dependsOn": ["@flow-state-dev/core#build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["CI", "REDIS_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
